/target
**/*.rs.bk
/screenshots/*.png
!/screenshots/.gitkeep
.DS_Store
*.log
/.claude/
screenshots/

# Third-party art downloaded by `cargo run -p fetch-assets` (assets/manifests)
/assets/fetched/

# Scenes and prefabs the editor saves when run from the repo root (games/editor)
/scenes/
/prefabs/
# The editor's favorites and trash (games/editor)
/.editor/
# Files the editor imports from elsewhere on disk
/assets/imported/

# Luau type definitions `script.types` writes for luau-lsp (engine_script)
/assets/scripts/engine.d.luau

# Written by ENGINE_PROFILE / --profile runs
engine-profile.txt

# Far-view proxies baked at run time (engine::hlod; ENGINE_HLOD_DIR moves it)
hlod-cache/
