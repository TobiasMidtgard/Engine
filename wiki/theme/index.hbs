<a class="cx-skip" href="#mdbook-content">Skip to the page</a>

<header class="cx-top">
    <button id="cx-menu" class="cx-iconbtn cx-menu" type="button" aria-label="Open the menu" aria-controls="cx-side" aria-expanded="false"><svg class="cx-i"><use href="#i-menu"/></svg></button>
    <a class="cx-brand" href="{{ path_to_root }}index.html" aria-label="{{ book_title }}, home">
        <svg class="cx-brand-mark" aria-hidden="true"><use href="#i-logo"/></svg>
        <span class="cx-brand-text"><span class="cx-brand-name">{{ book_title }}</span><span class="cx-brand-sub">World wiki</span></span>
    </a>
    {{#if search_enabled}}
    <button id="mdbook-search-toggle" class="cx-searchbtn" type="button" aria-expanded="false" aria-controls="mdbook-searchbar" aria-keyshortcuts="Control+K / s" title="Search (Ctrl K)">
        <svg class="cx-i" aria-hidden="true"><use href="#i-search"/></svg>
        <span class="cx-searchbtn-text">Search the wiki…</span>
        <kbd class="cx-kbd">Ctrl K</kbd>
    </button>
    {{/if}}
    <div class="cx-top-actions">
        <button id="cx-theme" class="cx-iconbtn" type="button" aria-label="Switch between dark and light" title="Dark or light">
            <svg class="cx-i cx-show-dark"><use href="#i-sun"/></svg><svg class="cx-i cx-show-light"><use href="#i-moon"/></svg>
        </button>
        <a class="cx-topbtn" href="{{ path_to_root }}editing/index.html"><svg class="cx-i" aria-hidden="true"><use href="#i-pen"/></svg><span>Contribute</span></a>
    </div>
</header>

{{#if search_enabled}}
<div id="mdbook-search-wrapper" class="cx-search hidden">
    <div class="cx-search-backdrop" data-close-search></div>
    <div class="cx-search-panel" role="dialog" aria-label="Search the wiki">
        <form id="mdbook-searchbar-outer" class="cx-search-form" role="search">
            <svg class="cx-i" aria-hidden="true"><use href="#i-search"/></svg>
            <input type="search" id="mdbook-searchbar" name="searchbar" placeholder="Search places, people, creatures, quests…" autocomplete="off" aria-controls="mdbook-searchresults-outer" aria-describedby="mdbook-searchresults-header">
            <span class="cx-search-spinner" aria-hidden="true"></span>
            <kbd class="cx-kbd">Esc</kbd>
        </form>
        <div id="mdbook-searchresults-outer" class="cx-search-results hidden">
            <div id="mdbook-searchresults-header" class="cx-search-header"></div>
            <ul id="mdbook-searchresults"></ul>
        </div>
        <p class="cx-search-hint"><kbd class="cx-kbd">↑</kbd> <kbd class="cx-kbd">↓</kbd> to choose, <kbd class="cx-kbd">Enter</kbd> to open</p>
    </div>
</div>
{{/if}}

<div class="cx-shell">
    <nav id="cx-side" class="cx-side" aria-label="Sections">
        <div id="cx-nav" class="cx-nav"></div>
        <noscript><p class="cx-noscript"><a href="{{ path_to_root }}toc.html">All pages</a></p></noscript>
    </nav>
    <div class="cx-side-backdrop" data-close-nav></div>

    <div class="cx-page">
        <div id="mdbook-content" class="cx-content">
            <main id="cx-page-main">
                {{{ content }}}
            </main>
            <nav class="cx-prevnext" aria-label="Previous and next page">
                {{#if previous}}
                <a rel="prev" class="cx-pn cx-pn-prev" href="{{ path_to_root }}{{ previous.link }}"><svg class="cx-i" aria-hidden="true"><use href="#i-back"/></svg><span><small>Previous</small>{{ previous.title }}</span></a>
                {{/if}}
                {{#if next}}
                <a rel="next prefetch" class="cx-pn cx-pn-next" href="{{ path_to_root }}{{ next.link }}"><span><small>Next</small>{{ next.title }}</span><svg class="cx-i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
                {{/if}}
            </nav>
        </div>
        <footer class="cx-foot">
            <span class="cx-foot-motto">Knowledge endures.</span>
            <span class="cx-foot-links">
                <a href="{{ path_to_root }}world/index.html">Explore</a>
                <a href="{{ path_to_root }}play/index.html">Learn</a>
                <a href="{{ path_to_root }}editing/index.html">Contribute</a>
                <a href="{{ path_to_root }}recent.html">Recent changes</a>
            </span>
        </footer>
    </div>
</div>

<!-- The chapter list (filled in by toc.js); codex.js reads it and never shows it. -->
<mdbook-sidebar-scrollbox id="cx-toc" hidden></mdbook-sidebar-scrollbox>

{{#if live_reload_endpoint}}
<script>
    const wsProtocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsAddress = wsProtocol + "//" + location.host + "/" + "{{{live_reload_endpoint}}}";
    const socket = new WebSocket(wsAddress);
    socket.onmessage = function (event) {
        if (event.data === "reload") {
            socket.close();
            location.reload();
        }
    };
    window.onbeforeunload = function () { socket.close(); };
</script>
{{/if}}

{{#if search_js}}
<script src="{{ resource "elasticlunr.min.js" }}"></script>
<script src="{{ resource "mark.min.js" }}"></script>
{{/if}}
{{#each additional_js}}
<script src="{{ resource this }}"></script>
{{/each}}
{{#if search_js}}
<script src="{{ resource "searcher.js" }}"></script>
{{/if}}
<script>window.codexAfterSearch && window.codexAfterSearch();</script>

{{#if fragment_map}}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fragmentMap = {{{fragment_map}}};
        const target = fragmentMap[window.location.hash];
        if (target) {
            let url = new URL(target, window.location.href);
            window.location.replace(url.href);
        }
    });
</script>
{{/if}}
</body>
</html>
