<!DOCTYPE HTML>
<html lang="{{ language }}" class="cx-dark" dir="{{ text_direction }}">
<head>
    <!-- The Codex: the player wiki's own page template (mdBook 0.5). theme/codex.js builds the
         sidebar, breadcrumbs, tabs and side panel; theme/wiki.css is the whole look. -->
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    {{#if is_print }}
    <meta name="robots" content="noindex">
    {{/if}}
    {{#if base_url}}
    <base href="{{ base_url }}">
    {{/if}}
    <meta name="description" content="{{ description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#111317">
    {{#if favicon_svg}}
    <link rel="icon" href="{{ resource "favicon.svg" }}">
    {{/if}}
    {{#if favicon_png}}
    <link rel="shortcut icon" href="{{ resource "favicon.png" }}">
    {{/if}}
    <link rel="stylesheet" href="{{ resource "fonts/fonts.css" }}">
    {{#each additional_css}}
    <link rel="stylesheet" href="{{ resource this }}">
    {{/each}}
    <script>
        const path_to_root = "{{ path_to_root }}";
        {{#if search_js}}
        window.path_to_searchindex_js = "{{ resource "searchindex.js" }}";
        {{/if}}
        // Dark is the Codex's own look; a reader can switch to the light parchment theme.
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("codex-theme"); } catch (e) { }
            var html = document.documentElement;
            html.classList.add("js");
            if (theme === "light") { html.classList.remove("cx-dark"); html.classList.add("cx-light"); }
            var spoilers = null;
            try { spoilers = localStorage.getItem("codex-spoilers"); } catch (e) { }
            if (spoilers === "shown") { html.classList.add("cx-spoilers-shown"); }
        })();
    </script>
    <!-- The chapter list, loaded once for every page; codex.js turns it into the sidebar. -->
    <script src="{{ resource "toc.js" }}"></script>
</head>
<body data-path="{{ path }}" data-edit="{{ git_repository_edit_url }}">
